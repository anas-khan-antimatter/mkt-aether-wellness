{
  "schema": 1,
  "runsOn": "ubuntu-latest",
  "setup": [
    "npm ci"
  ],
  "build": [
    "npm run build"
  ],
  "probes": [
    {
      "kind": "browser",
      "url": "/book"
    },
    {
      "kind": "browser",
      "url": "/check-in"
    },
    {
      "kind": "browser",
      "url": "/services"
    },
    {
      "kind": "browser",
      "url": "/team"
    },
    {
      "kind": "browser",
      "url": "/portal"
    },
    {
      "kind": "http",
      "url": "/api/book"
    },
    {
      "kind": "http",
      "url": "/api/prompt"
    },
    {
      "kind": "http",
      "url": "/api/suggest"
    },
    {
      "kind": "http",
      "url": "/api/portal/bookings"
    }
  ]
}